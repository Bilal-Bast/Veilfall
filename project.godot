; Veilfall: The Last Light — prototype for Godot 4.7 (Godot 4.x compatible)
config_version=5

[application]
config/name="VEILFALL - The Last Light"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
GameFeedback="*res://scripts/game_feedback.gd"
Sfx="*res://scripts/sfx.gd"
GameState="*res://scripts/game_state.gd"
SaveManager="*res://scripts/save_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
RegionAudio="*res://scripts/region_audio.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
2d/default_gravity=1050.0

[input]
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319), Object(InputEventJoypadMotion,"axis":0,"axis_value":-1.0), Object(InputEventJoypadButton,"button_index":13)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321), Object(InputEventJoypadMotion,"axis":0,"axis_value":1.0), Object(InputEventJoypadButton,"button_index":14)]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32), Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320), Object(InputEventJoypadButton,"button_index":0), Object(InputEventJoypadButton,"button_index":11)]
}
attack={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74), Object(InputEventMouseButton,"button_index":1), Object(InputEventJoypadButton,"button_index":2)]
}
shift_realm={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81), Object(InputEventKey,"physical_keycode":4194306), Object(InputEventJoypadButton,"button_index":3)]
}
restart={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
air_dash={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75), Object(InputEventKey,"physical_keycode":4194325), Object(InputEventJoypadButton,"button_index":1)]
}
lantern_pulse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":76), Object(InputEventJoypadButton,"button_index":5)]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69), Object(InputEventJoypadButton,"button_index":9)]
}
world_map={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":77), Object(InputEventJoypadButton,"button_index":4)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305), Object(InputEventJoypadButton,"button_index":6)]
}
journal={
