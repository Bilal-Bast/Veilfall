; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VEILFALL - The Last Light"
run/main_scene="res://scenes/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

GameFeedback="*res://scripts/game_feedback.gd"
Sfx="*res://scripts/sfx.gd"
GameState="*res://scripts/game_state.gd"
SaveManager="*res://scripts/save_manager.gd"
SettingsManager="*res://scripts/settings_manager.gd"
RegionAudio="*res://scripts/region_audio.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

